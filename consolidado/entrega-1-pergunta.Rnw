<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(
  echo       = FALSE,
  message    = FALSE,
  warning    = FALSE,
  fig.align  = "center",
  out.width  = "0.58\\linewidth",
  fig.width  = 5.2,
  fig.height = 3.8
)
options(OutDec = ",", digits = 4)
@

<<dados, include=FALSE>>=
# =========================================================================
#  BLOCO DO BANCO DE DADOS E VALIDAÇÃO CRUZADA: IPDM Baixada Santista
# =========================================================================
arq_csv <- "../estrutura/bancoDeDados/df_ipdm_baixada_por_municipio.csv"
if (!file.exists(arq_csv)) {
  arq_csv <- "estrutura/bancoDeDados/df_ipdm_baixada_por_municipio.csv"
}
if (!file.exists(arq_csv)) {
  arq_csv <- paste0(
    "https://raw.githubusercontent.com/",
    "Megalonnix/proj_ivan_gustavo_jorge_IPDM/main/",
    "estrutura/bancoDeDados/df_ipdm_baixada_por_municipio.csv"
  )
}

bruto <- read.csv(arq_csv, sep = ";", dec = ",", fileEncoding = "latin1",
                  check.names = FALSE, stringsAsFactors = FALSE)

dados <- data.frame(
  municipio         = factor(bruto[[2]]),
  ano               = as.integer(bruto[[3]]),
  riqueza           = as.numeric(bruto[[4]]),
  longevidade       = as.numeric(bruto[[5]]),
  escolaridade      = as.numeric(bruto[[6]]),
  ipdm              = as.numeric(bruto[[7]]),
  mortalidade_60_69 = as.numeric(bruto[[8]]),
  distorcao_em      = as.numeric(bruto[[9]]),
  pib_per_capita    = as.numeric(bruto[[10]])
)
dados$ano_f <- factor(dados$ano)

f1 <- function(x, d = 2) formatC(x, format = "f", digits = d, big.mark = ".", decimal.mark = ",")
f0 <- function(x) formatC(as.integer(x), format = "d", big.mark = ".")
sgn <- function(x, d = 2) paste0(ifelse(x >= 0, "+", "-"), f1(abs(x), d))
tex <- function(x) gsub("_", "\\\\_", x)

y <- dados$mortalidade_60_69
n <- nrow(dados)
n_mun <- nlevels(dados$municipio)
n_ano <- nlevels(dados$ano_f)
p1 <- (n_mun - 1) + (n_ano - 1)
p2 <- 3
n_por_p1 <- n / p1
n_por_p2 <- n / p2
min_cat <- min(table(dados$municipio), table(dados$ano_f))

# --- Diagnóstico 1: Vazamento e correlações ---
num <- dados[sapply(dados, is.numeric)]
cc_all <- sort(abs(cor(num, use = "complete.obs")[, "mortalidade_60_69"]), decreasing = TRUE)
cc_all <- cc_all[names(cc_all) != "mortalidade_60_69"]

validos <- c("riqueza", "pib_per_capita", "distorcao_em", "ano", "escolaridade")
cc_val <- sort(abs(cor(dados[, validos], y)[, 1]), decreasing = TRUE)

# --- Diagnóstico 3 e 4: Balanço e faltantes ---
med_global <- median(y)
n_alta <- sum(y > med_global)
n_baixa <- n - n_alta
faltantes <- sum(is.na(dados))

# --- Validação cruzada em k = 5 dobras (mesmas dobras para P1 e P2) ---
auc_fun <- function(prob, real) {
  if (length(unique(real)) < 2) return(NA_real_)
  pos <- prob[real == 1]; neg <- prob[real == 0]
  mean(outer(pos, neg, ">") + 0.5 * outer(pos, neg, "=="))
}

faz_dobras <- function(n, k, fatores, seed = 1) {
  set.seed(seed)
  repeat {
    d <- sample(rep(1:k, length.out = n))
    ok <- TRUE
    for (j in 1:k) for (f in fatores) {
      if (!all(levels(f) %in% as.character(f[d != j]))) ok <- FALSE
    }
    if (ok) return(d)
  }
}

k <- 5
dobras <- faz_dobras(n, k, list(dados$municipio, dados$ano_f), seed = 1)

mse_b1 <- numeric(k); mse_q1 <- numeric(k); mse_q1x <- numeric(k)
mae_b1 <- numeric(k); mae_q1 <- numeric(k); mae_q1x <- numeric(k)
acc_b  <- numeric(k); acc_q2 <- numeric(k); auc_q2  <- numeric(k)
acc_q1c <- numeric(k); auc_q1c <- numeric(k)

for (j in 1:k) {
  tr <- dados[dobras != j, ]; te <- dados[dobras == j, ]

  # P1: regressão (efeitos fixos de município e ano)
  m1  <- lm(mortalidade_60_69 ~ municipio + ano_f, data = tr)
  m1x <- lm(mortalidade_60_69 ~ municipio + ano_f + riqueza + escolaridade + distorcao_em, data = tr)
  p_m1  <- predict(m1, newdata = te)
  p_m1x <- predict(m1x, newdata = te)
  b_m1  <- mean(tr$mortalidade_60_69)

  mse_b1[j]  <- mean((te$mortalidade_60_69 - b_m1)^2)
  mse_q1[j]  <- mean((te$mortalidade_60_69 - p_m1)^2)
  mse_q1x[j] <- mean((te$mortalidade_60_69 - p_m1x)^2)

  mae_b1[j]  <- mean(abs(te$mortalidade_60_69 - b_m1))
  mae_q1[j]  <- mean(abs(te$mortalidade_60_69 - p_m1))
  mae_q1x[j] <- mean(abs(te$mortalidade_60_69 - p_m1x))

  # P2: classificação (mediana calculada apenas no treino da dobra)
  med_tr <- median(tr$mortalidade_60_69)
  tr$y_bin <- as.integer(tr$mortalidade_60_69 > med_tr)
  te$y_bin <- as.integer(te$mortalidade_60_69 > med_tr)
  m2 <- glm(y_bin ~ riqueza + escolaridade + distorcao_em, data = tr, family = binomial)
  prob2 <- predict(m2, newdata = te, type = "response")
  maj <- as.integer(mean(tr$y_bin) >= 0.5)

  acc_b[j]  <- mean(te$y_bin == maj)
  acc_q2[j] <- mean((prob2 > 0.5) == te$y_bin)
  auc_q2[j] <- auc_fun(prob2, te$y_bin)

  # P1 cortado na mediana do treino da dobra (teste de dominância sobre P2)
  acc_q1c[j] <- mean((p_m1 > med_tr) == te$y_bin)
  auc_q1c[j] <- auc_fun(p_m1, te$y_bin)
}

rmse_b1  <- sqrt(mean(mse_b1));  dp_b1  <- sd(sqrt(mse_b1))
rmse_q1  <- sqrt(mean(mse_q1));  dp_q1  <- sd(sqrt(mse_q1))
rmse_q1x <- sqrt(mean(mse_q1x)); dp_q1x <- sd(sqrt(mse_q1x))

m_mae_b1  <- mean(mae_b1)
m_mae_q1  <- mean(mae_q1)
m_mae_q1x <- mean(mae_q1x)

m_acc_b   <- mean(acc_b);   dp_acc_b   <- sd(acc_b)
m_acc_q2  <- mean(acc_q2);  dp_acc_q2  <- sd(acc_q2)
m_auc_q2  <- mean(auc_q2);  dp_auc_q2  <- sd(auc_q2)
m_acc_q1c <- mean(acc_q1c); dp_acc_q1c <- sd(acc_q1c)
m_auc_q1c <- mean(auc_q1c); dp_auc_q1c <- sd(auc_q1c)

ganho_p1  <- 100 * (1 - rmse_q1 / rmse_b1)
ganho_p1x <- 100 * (1 - rmse_q1x / rmse_b1)
ganho_p2  <- 100 * ((m_acc_q2 - m_acc_b) / (1 - m_acc_b))
ganho_p1c <- 100 * ((m_acc_q1c - m_acc_b) / (1 - m_acc_b))

# Efeitos estruturais descritivos
mu_geral <- mean(y)
ef_mun <- sort(tapply(y, dados$municipio, mean) - mu_geral, decreasing = TRUE)
ef_ano <- tapply(y, dados$ano_f, mean) - mu_geral
@

\selectlanguage{brazilian}
\frenchspacing

\maketitle

\begin{center}
  \small
  Fatec Baixada Santista -- Rubens Lara \\
  \nomecurso{} \quad|\quad \nomedisciplina{} \quad|\quad \nomeprofessor{} \\[0.4em]
  \integrantes \\[0.4em]
  Repositório: \texttt{\repositorio}
\end{center}

\textual

% ==========================================================================
\section{Introdução}
% ==========================================================================
O monitoramento da mortalidade na faixa etária de 60 a 69 anos é um instrumento decisivo para o planejamento de políticas públicas de saúde, especialmente no dimensionamento da atenção básica e da rede hospitalar de média e alta complexidade. Na Região Metropolitana da Baixada Santista, identificar se os óbitos nessa faixa respondem sobretudo a diferenças estruturais permanentes entre municípios, a choques temporais ou a flutuações de indicadores socioeconômicos permite alocar recursos regionais com maior precisão.

Seguindo o arcabouço da Teoria do Aprendizado Estatístico \citep{james2021}, este documento apresenta o banco de dados do trabalho, formula duas perguntas candidatas — uma de regressão focada em inferência estrutural ($P_1$) e outra de classificação preditiva ($P_2$) — e defende a escolha de $P_1$ por meio de diagnósticos formais e validação cruzada. Conforme destacam \citeonline{bruce2019}, a definição rigorosa da métrica de erro e da linha de base precede a seleção de qualquer modelo parametrizado ou flexível.

% ==========================================================================
\section{O banco de dados e o problema}
% ==========================================================================
Os dados provêm do Índice Paulista de Desenvolvimento Municipal (IPDM), compilado pela \citeonline{fonte_dados}. A unidade amostral é o par \textbf{município-ano}: o recorte abrange os $\Sexpr{n_mun}$ municípios da Região Metropolitana da Baixada Santista (Bertioga, Cubatão, Guarujá, Itanhaém, Mongaguá, Peruíbe, Praia Grande, Santos e São Vicente) observados em $\Sexpr{n_ano}$ edições bienais (2014, 2016, 2018, 2020, 2022 e 2024), totalizando $n = \Sexpr{f0(n)}$ observações em um painel perfeitamente balanceado.

A variável resposta de interesse é \texttt{mortalidade\_60\_69} ($Y$), que registra a taxa de mortalidade de residentes de 60 a 69 anos (óbitos por mil habitantes nessa faixa etária). O \emph{problema de decisão} pertence às secretarias municipais e à gestão regional de saúde da Baixada Santista: decidir quais municípios demandam priorização estrutural permanente na prevenção ao óbito precoce de idosos e separar esse efeito estrutural local de choques epidemiológicos globais (como a pandemia de COVID-19).

% ==========================================================================
\section{As duas perguntas candidatas}
% ==========================================================================
Ao longo das etapas exploratórias do projeto (Atividades 03 a 08), constatou-se que regredir a mortalidade exclusivamente contra indicadores sociais agregados sem controlar pelo município e pelo ano resultava em modelos incapazes de superar a média amostral. Para confrontar formalmente o paradigma de efeitos estruturais contra o de predição puramente socioeconômica, formulamos as duas perguntas candidatas detalhadas na Tabela~\ref{tab:ficha}.

\begin{table}[htb]
  \centering
  \caption{Ficha das duas perguntas candidatas}
  \label{tab:ficha}
  \footnotesize
  \begin{tabular}{@{}p{0.18\textwidth}p{0.40\textwidth}p{0.36\textwidth}@{}}
    \toprule
    \textbf{Campo} & \textbf{Pergunta 1 (escolhida)} & \textbf{Pergunta 2 (concorrente)} \\
    \midrule
    1. Pergunta & Quanto a mortalidade de 60 a 69 anos varia com \emph{onde} (município) e \emph{quando} (ano) — e quais municípios ficam acima do esperado para o seu ano? &
      Só com indicadores sociais, é possível antecipar quais município-anos terão mortalidade de 60 a 69 anos acima da mediana? \\
    2. Resposta $Y$ & \texttt{mortalidade\_60\_69}, quantitativa contínua (mortes por mil hab.) &
      $\mathbf{1}\{\texttt{mortalidade\_60\_69} > \text{mediana}_{\text{treino}}\}$, binária (0/1) \\
    3. Preditores $X$ & \texttt{municipio} (9 níveis) e \texttt{ano} como fator (6 níveis); $p = \Sexpr{p1}$ \emph{dummies} &
      \texttt{riqueza}, \texttt{escolaridade} e \texttt{distorcao\_em} ($p = \Sexpr{p2}$) \\
    4. Tipo & supervisionado; regressão; \textbf{inferência} &
      supervisionado; classificação; \textbf{predição} \\
    5. Métrica & RMSE em mortes/mil hab. (apoio: MAE) em CV($\Sexpr{k}$) &
      AUC (apoio: acurácia) em CV($\Sexpr{k}$) \\
    6. Linha de base & média do treino: RMSE $= \Sexpr{f1(rmse_b1)}$ (MAE $= \Sexpr{f1(m_mae_b1)}$) &
      classe majoritária: acurácia $= \Sexpr{f1(100*m_acc_b, 1)}\%$; AUC $= 0{,}500$ \\
    7. Dono do problema & Secretarias de saúde da Baixada: priorizar recursos na rede de atenção ao idoso &
      Gestão regional: sinalizar risco via indicadores sociais antes do fechamento de óbitos \\
    \bottomrule
  \end{tabular}
  \fonte{Elaborada pelos autores.}
\end{table}

Na Pergunta~1, o modelo aditivo de efeitos fixos de painel assume a forma estrutural:
\begin{equation}
  y_{it} = \mu + \alpha_i + \gamma_t + \varepsilon_{it}, \qquad i = 1,\dots,9 \text{ (municípios)}, \quad t = 1,\dots,6 \text{ (anos)},
\end{equation}
onde $\alpha_i$ mede o desvio estrutural do município $i$ e $\gamma_t$ captura o choque comum do biênio $t$ \citep{james2021}.

% ==========================================================================
\section{Defesa da pergunta e validação cruzada}
% ==========================================================================
A Tabela~\ref{tab:diag} sintetiza as quatro verificações diagnósticas realizadas sobre o banco.

\begin{table}[htb]
  \centering
  \caption{Diagnóstico do banco de dados}
  \label{tab:diag}
  \footnotesize
  \begin{tabular}{@{}p{0.32\textwidth}p{0.62\textwidth}@{}}
    \toprule
    \textbf{Verificação} & \textbf{Resultado} \\
    \midrule
    Tamanho ($n \times p$)   & $n = \Sexpr{n}$; $P_1$: $p = \Sexpr{p1}$ \emph{dummies} ($n/p = \Sexpr{f1(n_por_p1, 1)}$) \quad|\quad $P_2$: $p = \Sexpr{p2}$ ($n/p = \Sexpr{f1(n_por_p2, 1)}$) \\
    Linha de base em CV($\Sexpr{k}$) & $P_1$: RMSE $= \Sexpr{f1(rmse_b1)}$ (DP $= \Sexpr{f1(dp_b1)}$) \quad|\quad $P_2$: acurácia $= \Sexpr{f1(100*m_acc_b, 1)}\%$, AUC $= 0{,}500$ \\
    Maior correlação com $Y$ & Bruta: \texttt{longevidade} ($\Sexpr{f1(cc_all["longevidade"], 3)}$) e \texttt{ipdm} ($\Sexpr{f1(cc_all["ipdm"], 3)}$); sem vazamento: \texttt{riqueza} ($\Sexpr{f1(cc_val["riqueza"], 3)}$) \\
    Balanço ($P_2$, base cheia) & $\Sexpr{n_alta}$ alta ($\Sexpr{f1(100*n_alta/n, 1)}\%$) vs.\ $\Sexpr{n_baixa}$ baixa ($\Sexpr{f1(100*n_baixa/n, 1)}\%$); corte na mediana global $= \Sexpr{f1(med_global)}$ \\
    Valores faltantes        & $\Sexpr{faltantes}$ (nenhuma coluna possui valores ausentes) \\
    \bottomrule
  \end{tabular}
  \fonte{Elaborada pelos autores.}
\end{table}

\textbf{Vazamento.} O diagnóstico de correlação aponta \texttt{longevidade} ($|r| = \Sexpr{f1(cc_all["longevidade"], 3)}$) e \texttt{ipdm} ($|r| = \Sexpr{f1(cc_all["ipdm"], 3)}$) como as variáveis mais correlacionadas com $Y$. Embora os valores estejam longe de $1{,}00$ e não disparem um alarme puramente numérico, a auditoria do dicionário metodológico da Fundação Seade revela um \textbf{vazamento conceitual por circularidade}: o indicador sintético de \texttt{longevidade} é calculado diretamente a partir da taxa de mortalidade de 60 a 69 anos, e o \texttt{ipdm} é a média aritmética de riqueza, longevidade e escolaridade. Portanto, ambas foram banidas de $P_1$ e $P_2$. Entre os preditores socioeconômicos legítimos, a maior correlação linear com $Y$ é a de \texttt{riqueza} ($|r| = \Sexpr{f1(cc_val["riqueza"], 3)}$).

\textbf{Tamanho, balanço e dependência.} Com $n = \Sexpr{n}$ e $p = \Sexpr{p1}$ na Pergunta~1, a razão $n/p = \Sexpr{f1(n_por_p1, 1)}$ exige cautela, mas o desenho ortogonal do painel garante exatamente $\Sexpr{min_cat}$ observações por município e $9$ por ano. Na Pergunta~2, o corte pela mediana é reestimado \textbf{estritamente dentro de cada dobra de treino} para evitar vazamento de informação do conjunto de validação. Além disso, como cada município se repete 6 vezes, a validação cruzada aleatória é otimista para $P_2$ caso o objetivo fosse extrapolar para um município externo à Baixada.

\begin{table}[htb]
  \centering
  \caption{Validação cruzada ($k = \Sexpr{k}$): média entre dobras (desvio-padrão)}
  \label{tab:cv}
  \footnotesize
  \resizebox{\textwidth}{!}{%
  \begin{tabular}{@{}llccc@{}}
    \toprule
    \textbf{Pergunta} & \textbf{Modelo avaliado} & \textbf{Métrica principal} & \textbf{Métrica de apoio} & \textbf{Redução erro} \\
    \midrule
    $P_1$ (RMSE, MAE) & Linha de base: média do treino & $\Sexpr{f1(rmse_b1)}$ ($\Sexpr{f1(dp_b1)}$) & MAE $= \Sexpr{f1(m_mae_b1)}$ & $0{,}0\%$ \\
      & \texttt{lm}: \texttt{municipio + factor(ano)} & $\mathbf{\Sexpr{f1(rmse_q1)}}$ ($\Sexpr{f1(dp_q1)}$) & MAE $= \mathbf{\Sexpr{f1(m_mae_q1)}}$ & $\mathbf{\Sexpr{f1(ganho_p1, 1)}\%}$ \\
      & \texttt{lm}: \texttt{municipio + factor(ano) + 3 sociais} & $\Sexpr{f1(rmse_q1x)}$ ($\Sexpr{f1(dp_q1x)}$) & MAE $= \Sexpr{f1(m_mae_q1x)}$ & $\Sexpr{f1(ganho_p1x, 1)}\%$ \\
    \midrule
    $P_2$ (AUC, Acc) & Linha de base: classe mais comum & $0{,}500$ ($0{,}000$) & Acc $= \Sexpr{f1(100*m_acc_b, 1)}\%$ & $0{,}0\%$ \\
      & \texttt{glm} logístico (3 ind.\ sociais) & $\Sexpr{f1(m_auc_q2, 3)}$ ($\Sexpr{f1(dp_auc_q2, 3)}$) & Acc $= \Sexpr{f1(100*m_acc_q2, 1)}\%$ & $\Sexpr{f1(ganho_p2, 1)}\%$ \\
      & \texttt{lm} da $P_1$ cortado na mediana do treino & $\mathbf{\Sexpr{f1(m_auc_q1c, 3)}}$ ($\Sexpr{f1(dp_auc_q1c, 3)}$) & Acc $= \mathbf{\Sexpr{f1(100*m_acc_q1c, 1)}\%}$ & $\mathbf{\Sexpr{f1(ganho_p1c, 1)}\%}$ \\
    \bottomrule
  \end{tabular}%
  }
  \fonte{Elaborada pelos autores. Mesmas dobras (\texttt{seed = 1}) em todos os modelos; base e mediana reestimadas em cada dobra.}
\end{table}

\begin{figure}[htb]
  \centering
  \caption{Distribuição da taxa de mortalidade de 60 a 69 anos na Baixada Santista (2014--2024)}
  \label{fig:resposta}
<<fig-resposta>>=
par(mar = c(4, 4, 0.8, 0.8), pty = "s", las = 1)
hist(y, breaks = 14, col = "#D6EAF3", border = "white",
     main = "", xlab = "mortalidade_60_69 (mortes por mil hab.)", ylab = "frequencia")
abline(v = mean(y), col = "#276DC3", lwd = 2.2, lty = 1)
abline(v = med_global, col = "#E66101", lwd = 2.2, lty = 2)
legend("topright", bty = "n", cex = 0.82,
       legend = c(paste0("media (", f1(mean(y)), ")"),
                  paste0("mediana / corte P2 (", f1(med_global), ")")),
       col = c("#276DC3", "#E66101"), lwd = 2.2, lty = c(1, 2))
@
  \fonte{Elaborada pelos autores.}
\end{figure}

\textbf{Escolha pelos números e prova de dominância.} Conforme demonstra a Tabela~\ref{tab:cv}, a Pergunta~1 reduz o RMSE fora da amostra de $\Sexpr{f1(rmse_b1)}$ para $\mathbf{\Sexpr{f1(rmse_q1)}}$ mortes por mil habitantes (eliminando $\mathbf{\Sexpr{f1(ganho_p1, 1)}\%}$ do erro da linha de base), enquanto a logística socioeconômica da Pergunta~2 elimina $\Sexpr{f1(ganho_p2, 1)}\%$ do erro de classificação (AUC $= \Sexpr{f1(m_auc_q2, 3)}$). O argumento definitivo está na última linha da Tabela~\ref{tab:cv}: quando dicotomizamos a predição contínua da Pergunta~1 na mediana do treino de cada dobra para responder à Pergunta~2, obtemos $\text{AUC} = \mathbf{\Sexpr{f1(m_auc_q1c, 3)}}$ e acurácia de $\mathbf{\Sexpr{f1(100*m_acc_q1c, 1)}\%}$, batendo com ampla margem o próprio modelo logístico da Pergunta~2 ($\Sexpr{f1(m_auc_q2, 3)}$). Em suma: a Pergunta~1 contém a resposta da Pergunta~2 com desempenho superior, além de entregar a magnitude em óbitos por mil habitantes.

\textbf{Resultados substantivos e veredito.} O ajuste da Pergunta~1 revela que, em torno da média regional ($\Sexpr{f1(mu_geral)}$ mortes/mil hab.), os municípios estruturalmente mais vulneráveis são Mongaguá ($\Sexpr{sgn(ef_mun["Mongaguá"])}$) e Itanhaém ($\Sexpr{sgn(ef_mun["Itanhaém"])}$), ao passo que Santos apresenta o menor patamar ($\Sexpr{sgn(ef_mun["Santos"])}$). No eixo temporal, o biênio pandêmico de 2022 produziu um choque positivo severo de $\Sexpr{sgn(ef_ano["2022"])}$ mortes/mil hab., seguido de retração em 2024 ($\Sexpr{sgn(ef_ano["2024"])}$). Somar os três indicadores sociais contínuos ao modelo fixo eleva o RMSE para $\Sexpr{f1(rmse_q1x)}$ devido ao excesso de parâmetros colineares com o efeito municipal em $n = \Sexpr{n}$. A pergunta escolhida se sustenta e permanece \textbf{provisória} até a revisão após a Aula~12, quando suavizadores não-paramétricos (GAM) e árvores/\emph{ensembles} permitirão testar não-linearidades e interações município $\times$ ano.

