<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(
  echo       = FALSE,
  message    = FALSE,
  warning    = FALSE,
  fig.align  = "center",
  out.width  = "0.52\\linewidth",
  fig.width  = 4,
  fig.height = 4
)
options(OutDec = ",", digits = 4)
@

<<dados, include=FALSE>>=
# =========================================================================
#  BLOCO DO BANCO DE DADOS: IPDM da Baixada Santista (Seade)
# =========================================================================
arq_csv <- "../estrutura/bancoDeDados/df_ipdm_baixada_por_municipio.csv"
if (!file.exists(arq_csv)) {
  arq_csv <- paste0(
    "https://raw.githubusercontent.com/",
    "Megalonnix/proj_ivan_gustavo_jorge_IPDM/main/",
    "estrutura/bancoDeDados/df_ipdm_baixada_por_municipio.csv"
  )
}

bruto <- read.csv(arq_csv, sep = ";", dec = ",", fileEncoding = "latin1",
                  check.names = FALSE, stringsAsFactors = FALSE)

dados <- data.frame(
  municipio         = factor(bruto[[2]]),
  ano               = as.integer(bruto[[3]]),
  riqueza           = as.numeric(bruto[[4]]),
  longevidade       = as.numeric(bruto[[5]]),
  escolaridade      = as.numeric(bruto[[6]]),
  ipdm              = as.numeric(bruto[[7]]),
  mortalidade_60_69 = as.numeric(bruto[[8]]),
  distorcao_em      = as.numeric(bruto[[9]]),
  pib_per_capita    = as.numeric(bruto[[10]])
)

resposta <- "mortalidade_60_69"
tex <- function(x) gsub("_", "\\\\_", x)

y            <- dados[[resposta]]
quantitativa <- is.numeric(y)
n            <- nrow(dados)
p            <- 13
resposta_tex <- tex(resposta)

if (quantitativa) {
  valor_base       <- sd(y, na.rm = TRUE)
  texto_base       <- paste0("RMSE = ", format(round(valor_base, 2), nsmall = 2))
  nome_base        <- "chutar sempre a m\\'edia"
  palavra_tipo     <- "regress\\~ao"
  palavra_resposta <- "quantitativa"
  palavra_metrica  <- "RMSE, na unidade de $Y$"
} else {
  valor_base       <- max(table(y)) / sum(table(y))
  texto_base       <- paste0("acur\\'acia = ", format(round(valor_base, 3), nsmall = 3))
  nome_base        <- "chutar a classe mais comum"
  palavra_tipo     <- "classifica\\c{c}\\~ao"
  palavra_resposta <- "qualitativa"
  palavra_metrica  <- "acur\\'acia ou AUC"
}

num <- dados[sapply(dados, is.numeric)]
if (quantitativa && ncol(num) > 1) {
  cc <- abs(cor(num, use = "complete.obs")[, resposta])
  cc <- sort(cc[names(cc) != resposta], decreasing = TRUE)
  texto_cor <- paste0("\\texttt{", tex(names(cc)[1]), "}: ",
                      format(round(cc[1], 3), nsmall = 3))
} else {
  texto_cor <- "n\\~ao se aplica (resposta qualitativa)"
}

if (quantitativa) {
  texto_balanco <- "n\\~ao se aplica (resposta quantitativa)"
} else {
  texto_balanco <- paste(paste0("\\texttt{", tex(names(table(y))), "}: ",
                                as.integer(table(y))), collapse = " | ")
}

faltantes <- colSums(is.na(dados))
texto_falta <- if (sum(faltantes) == 0) {
  "nenhum"
} else {
  paste(paste0("\\texttt{", tex(names(faltantes)[faltantes > 0]), "}: ",
               faltantes[faltantes > 0]), collapse = " | ")
}
@

